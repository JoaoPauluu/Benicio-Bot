# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini model id, e.g. gemini-2.5-flash, gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Your personal number (the owner), digits only with country code, e.g. 5511999998888
OWNER_NUMBER=

# Timezone used for schedules and the daily bomdia pick
TIMEZONE=America/Sao_Paulo

# Page scraped by the bomdia command (selectors in commands/bomdia.py)
BOMDIA_URL=https://www.pensador.com/frases_de_bom_dia/

# Commentator mode: comment every N group messages
COMENTARISTA_INTERVAL=10

# Answer DMs from people other than the owner (uses your Gemini quota)
ALLOW_DMS_FROM_OTHERS=false

# AIO Toolkit (yt-dlp) used by `baixar`. In Docker on the shared network: http://aio-toolkit:8080
AIO_BASE_URL=http://localhost:8765
# Max time a download may take (90s / 30m / 1h)
BAIXAR_TIMEOUT=30m
# Files bigger than this (MB) are sent as an AIO share link instead of a WhatsApp video
BAIXAR_MAX_MB=100
# Share link expiry: 1h | 1d | 7d | 30d | never
BAIXAR_SHARE_EXPIRES=1d
